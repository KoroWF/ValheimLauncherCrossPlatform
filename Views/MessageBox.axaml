<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ValheimCrossPlatformLauncher.MessageBox"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Benachrichtigung">
  <StackPanel Margin="20">
    <TextBlock Name="MessageBlock" TextWrapping="Wrap" MinWidth="200" MaxWidth="400" />
    <Button Content="OK" HorizontalAlignment="Center" Margin="0,10,0,0" Click="OnOKClick" />
  </StackPanel>
</Window>
